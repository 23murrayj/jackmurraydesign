#!/bin/sh
# ---------------------------------------------------------------------------
# Keeps the plain-HTML copy of the projects current, without anyone having to
# remember to.
#
# index.html carries the six projects as real markup - titles, descriptions
# and the full write-ups - so that anything reading the page without running
# its JavaScript can see what the work is. See CLAUDE.md, "Machine readers are
# an audience". That block is a COPY of projectData and of i18n.js's English
# strings, generated by tools/write-fallback.js, and a copy that has to be
# refreshed by hand is a copy that goes stale. Jack, on being told to run the
# tool after editing a write-up: "I wont remember that so make sure it auto
# does it." Correct instinct - a maintenance step a person has to remember is
# a bug with a manual workaround.
#
# NOT A BUILD STEP, and the distinction matters because this project does not
# have one. Nothing runs at deploy and nothing runs in a visitor's browser.
# This runs on THIS machine when a commit is made, and what it produces is the
# same hand-editable static HTML that was always checked in.
#
# Installed with:  git config core.hooksPath .githooks
# tools/audit.js checks that config is set, because core.hooksPath is local
# and does not survive a fresh clone.
# ---------------------------------------------------------------------------

[ -n "$SKIP_FALLBACK_HOOK" ] && exit 0

command -v node >/dev/null 2>&1 || {
  echo "pre-commit: node not found, skipping the gallery-fallback refresh" >&2
  exit 0
}

root=$(git rev-parse --show-toplevel) || exit 0
cd "$root" || exit 0
[ -f tools/write-fallback.js ] || exit 0

# Whether index.html already had UNSTAGED edits before we touched it. If it
# did, we must not stage the file afterwards: `git add index.html` would sweep
# those unrelated edits into this commit, which is a far worse surprise than
# the stale block this hook exists to prevent. In that case: regenerate, say
# so, and stop.
dirty_before=$(git diff --name-only -- index.html)
before=$(git hash-object index.html)

node tools/write-fallback.js >/dev/null || {
  echo "pre-commit: tools/write-fallback.js failed - commit stopped." >&2
  echo "            Run it yourself to see the error:" >&2
  echo "            node tools/write-fallback.js" >&2
  exit 1
}

after=$(git hash-object index.html)
[ "$before" = "$after" ] && exit 0

if [ -n "$dirty_before" ]; then
  cat >&2 <<MSG

pre-commit: the project list in index.html was out of date, so it has been
            regenerated - but index.html had other unstaged edits, so nothing
            was staged for you. Nothing is lost; your edits are still there.

            Check them, then stage index.html yourself:
                git add index.html && git commit ...

MSG
  exit 1
fi

git add index.html
echo "pre-commit: project list in index.html regenerated from projectData + i18n.js, and staged."
exit 0
