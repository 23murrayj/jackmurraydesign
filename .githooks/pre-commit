#!/bin/sh
# ---------------------------------------------------------------------------
# Keeps the two generated things in the repo current, without anyone having to
# remember to.
#
#   index.html  the plain-HTML copy of the projects - titles, descriptions and
#               the full write-ups - so anything reading the page without
#               running its JavaScript can see what the work is. See CLAUDE.md,
#               "Machine readers are an audience". Generated by
#               tools/write-fallback.js from projectData + i18n.js.
#
#   script.js   the ?v= content hash on every asset URL that carries one.
#               vercel.json gives /assets/ an hour of freshness and a WEEK of
#               stale-while-revalidate, so changing the bytes at a path a
#               visitor has already loaded shows them the old file for days -
#               which is how a re-cropped photograph reached Jack looking
#               unchanged. Generated by tools/asset-rev.js from the files
#               themselves.
#
# Both are COPIES of something else in the repo, and a copy that has to be
# refreshed by hand is a copy that goes stale. Jack, on being told to run the
# first one after editing a write-up: "I wont remember that so make sure it
# auto does it." Correct instinct - a maintenance step a person has to
# remember is a bug with a manual workaround.
#
# NOT A BUILD STEP, and the distinction matters because this project does not
# have one. Nothing runs at deploy and nothing runs in a visitor's browser.
# This runs on THIS machine when a commit is made, and what it produces is the
# same hand-editable static files that were always checked in.
#
# Installed with:  git config core.hooksPath .githooks
# tools/audit.js checks that config is set, because core.hooksPath is local
# and does not survive a fresh clone.
# ---------------------------------------------------------------------------

[ -n "$SKIP_FALLBACK_HOOK" ] && exit 0

command -v node >/dev/null 2>&1 || {
  echo "pre-commit: node not found, skipping the generated-file refresh" >&2
  exit 0
}

root=$(git rev-parse --show-toplevel) || exit 0
cd "$root" || exit 0

# Run one generator over one file, then stage it - but ONLY if that file had
# no unstaged edits of its own before we started. `git add` on a file someone
# was midway through editing sweeps those unrelated changes into this commit,
# which is a far worse surprise than the stale content this hook prevents. In
# that case: regenerate, explain, stage nothing, and stop the commit.
refresh() {
  tool=$1; file=$2; what=$3
  [ -f "$tool" ] || return 0

  dirty_before=$(git diff --name-only -- "$file")
  before=$(git hash-object "$file")

  node "$tool" >/dev/null || {
    echo "pre-commit: $tool failed - commit stopped." >&2
    echo "            Run it yourself to see the error:" >&2
    echo "            node $tool" >&2
    exit 1
  }

  after=$(git hash-object "$file")
  [ "$before" = "$after" ] && return 0

  if [ -n "$dirty_before" ]; then
    cat >&2 <<MSG

pre-commit: $file is out of date ($what), so it has been
            regenerated - but $file had other unstaged edits, so
            nothing was staged for you. Nothing is lost; your edits are
            still there.

            Check them, then stage the file yourself:
                git add $file && git commit ...

MSG
    exit 1
  fi

  git add "$file"
  echo "pre-commit: refreshed $what in $file, and staged it."
}

refresh tools/write-fallback.js index.html "the project list"
refresh tools/asset-rev.js      script.js  "the asset ?v= hashes"
refresh tools/asset-rev.js      index.html "the resume ?v= hash"
exit 0
